ARG PYTORCH_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel
FROM ${PYTORCH_IMAGE} AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Install build dependencies + GStreamer via APT
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    python3-dev \
    python3-pip \
    cmake \
    pkg-config \
    libglib2.0-dev \
    libssl-dev \
    libyaml-cpp-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-tools \
    gstreamer1.0-x \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install scikit-build-core pybind11 build

WORKDIR /working/app
COPY . .

# Step 1: Build the native module with cmake
RUN rm -rf build && mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc)

# Step 2: Build wheel using pre-compiled _core.so (no rebuild)
RUN pip3 wheel --no-build-isolation --no-deps -w /working/wheels .


# Final Stage - Using the SAME image as requested (devel) for runtime to ensure compat
FROM ${PYTORCH_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video

# Runtime dependencies (GStreamer via APT)
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    libglib2.0-0 \
    libssl3 \
    libyaml-cpp-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    && rm -rf /var/lib/apt/lists/*

# Copy built wheel
COPY --from=builder /working/wheels /wheels

# CUDA Lib paths - leveraging the PyTorch environment
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu:/opt/conda/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:$LD_LIBRARY_PATH

WORKDIR /workspace

# Install rtspmodule from wheel + runtime dependencies
RUN pip3 install --no-cache-dir /wheels/*.whl \
    cupy-cuda12x \
    opencv-python \
    pyyaml \
    pynvml \
    psutil \
    aiohttp \
    simplejpeg \
    && rm -rf /wheels

CMD ["/bin/bash"]
