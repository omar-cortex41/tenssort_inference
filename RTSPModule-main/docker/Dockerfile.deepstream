# Build stage - compile the C++ RTSP module
FROM nvcr.io/nvidia/deepstream:7.1-triton-multiarch AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies (GStreamer is already in DeepStream)
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    python3-pip \
    libyaml-cpp-dev \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install scikit-build-core pybind11 build

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Run DeepStream additional install script for software decoder support
RUN cd /opt/nvidia/deepstream/deepstream && ./user_additional_install.sh

WORKDIR /working/app
COPY . .

# Step 1: Build the native module with cmake
RUN rm -rf build && mkdir build && cd build && \
    cmake .. && \
    make -j$(nproc)

# Step 2: Build wheel using pre-compiled _core.so (no rebuild)
RUN pip3 wheel --no-build-isolation --no-deps -w /working/wheels .


# Runtime stage - use DeepStream with GStreamer preinstalled
FROM nvcr.io/nvidia/deepstream:7.1-triton-multiarch

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
# DeepStream libraries (libnvbufsurface.so, etc.) need to be in library path
ENV LD_LIBRARY_PATH=/opt/nvidia/deepstream/deepstream/lib:$LD_LIBRARY_PATH

# Install Python and runtime dependencies + fix missing GStreamer libs
RUN apt-get update && apt-get install -y \
    python3-pip \
    libyaml-cpp-dev \
    && apt-get install --reinstall -y \
    libmp3lame0 \
    libxvidcore4 \
    libflac8 \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf ~/.cache/gstreamer-1.0

# Run DeepStream additional install script in runtime as well
RUN cd /opt/nvidia/deepstream/deepstream && ./user_additional_install.sh

# Copy built wheel
COPY --from=builder /working/wheels /wheels
COPY --from=builder /working/app/lib /workspace/lib

WORKDIR /workspace

# Install rtspmodule from wheel + runtime dependencies
RUN pip3 install --no-cache-dir /wheels/*.whl \
    cupy-cuda12x \
    opencv-python \
    pyyaml \
    psutil \
    pynvml \
    aiohttp \
    simplejpeg \
    && rm -rf /wheels

# DeepStream images might not set this by default for our workspace
ENV PYTHONPATH=/workspace:$PYTHONPATH
ENV GST_PLUGIN_PATH=/opt/nvidia/deepstream/deepstream/lib/gst-plugins:/workspace/lib

CMD ["/bin/bash"]
